# Kopiera denna fil till .env och fyll i din egen nyckel.
# Skapa nyckeln i Google Cloud Console: aktivera BÅDE "Routes API" och
# "Places API (New)" på samma projekt, sedan Credentials → Create API Key,
# och begränsa den till ert servers IP (inte till en Android-app
# — nyckeln ligger ju bara på servern, aldrig i appen).
GOOGLE_API_KEY=din-google-api-nyckel-har

# Valfritt — krävs bara för /charging-nobil (laddplatser via NOBIL, se
# https://nobil.no). Saknas den ger endpointen ett tydligt 500-fel istället
# för att krascha servern. Sätts som NOBIL_API_KEY i miljövariablerna på
# Render, inte i koden.
NOBIL_API_KEY=din-nobil-api-nyckel-har

# Valfritt, default 3000
PORT=3000

# Valfritt, default false — sätt till "true" för att logga rådata från
# NOBIL (begärd/faktisk avstånd per station, rått attr.st-avgiftsfält) i
# konsolen, för felsökning av /charging-nobil.
NOBIL_DEBUG=false
